# Local SQLite file. Use a persistent volume for a hosted installation.
SIMPLAY_DB_URL=.data/simplayz.sqlite
SIMPLAYZ_DEV_HOST=localhost:3000

# Optional: exact forwarded hostname for Next.js development access (no scheme).
# SIMPLAYZ_DEV_HOST=3000-your-sandbox-id.e2b.app

# Optional: allow a partitioned session cookie inside the HTTPS preview iframe.
# Leave unset for normal deployments (SameSite=Lax).
# SIMPLAYZ_EMBEDDED_PREVIEW_HOST=3000-your-sandbox-id.e2b.app
