# Optional local SQLite path, used only when Turso is not configured.
# DATABASE_PATH=.data/simplayz.sqlite

# Server-only Turso credentials. Set both in an ignored .env.local or Vercel's
# environment settings. Use separate databases for Preview and Production.
# SIMPLAY_DB_TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# SIMPLAY_DB_TURSO_AUTH_TOKEN=<database-auth-token>

# Optional: exact forwarded hostname for Next.js development access (no scheme).
# SIMPLAYZ_DEV_HOST=3000-your-sandbox-id.e2b.app

# Optional: allow a partitioned session cookie inside the HTTPS preview iframe.
# Leave unset for normal deployments (SameSite=Lax).
# SIMPLAYZ_EMBEDDED_PREVIEW_HOST=3000-your-sandbox-id.e2b.app
