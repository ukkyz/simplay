{
  "name": "simplayz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db.ts migrate",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:db && npm run build",
    "test:db": "tsx --test scripts/*.test.ts",
    "auth:alex": "tsx scripts/auth-alex.ts",
    "smoke": "node --test scripts/smoke.mjs",
    "db:seed": "tsx scripts/db.ts seed",
    "db:setup": "tsx scripts/db.ts setup",
    "db:import": "tsx scripts/db.ts import"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.75.0",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/env": "16.4.6",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.187.0",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.65.1",
    "postcss": "^8.5.6",
    "tailwindcss": "4.1.17",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "allowScripts": {
    "es5-ext@0.10.64": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true
  }
}
